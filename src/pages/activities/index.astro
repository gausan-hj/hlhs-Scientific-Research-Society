---
import BaseLayout from '@layouts/BaseLayout.astro';
import ActivityCard from '@components/activities/ActivityCard.astro';
import Pagination from '@components/common/Pagination.astro';
import ScrollReveal from '@components/common/ScrollReveal.astro';
import { sanityClient } from 'sanity:client';
import { ACTIVITIES_QUERY, ACTIVITIES_COUNT_QUERY } from '@sanity/queries';
import { SITE, ITEMS_PER_PAGE } from '@lib/constants';

const url = new URL(Astro.request.url);
const page = Math.max(1, parseInt(url.searchParams.get('page') || '1'));
const start = (page - 1) * ITEMS_PER_PAGE;
const end = start + ITEMS_PER_PAGE;

const [activities, total] = await Promise.all([
  sanityClient.fetch(ACTIVITIES_QUERY, { start, end }),
  sanityClient.fetch(ACTIVITIES_COUNT_QUERY),
]);
const totalPages = Math.ceil(total / ITEMS_PER_PAGE);
---

<BaseLayout title="活动" description="浏览科研学会的最新活动、工作坊及比赛信息" canonical={`${SITE.url}/activities`}>

  <!-- Hero -->
  <section class="pt-16 pb-8 lg:pt-24 lg:pb-10 text-center hero-gradient">
    <div class="container-custom">
      <div class="section-label justify-center">Activities</div>
      <h1 class="text-[clamp(2rem,5vw,3rem)] font-extrabold mb-4 text-text">活动</h1>
      <p class="text-base lg:text-lg leading-relaxed max-w-2xl mx-auto text-text-secondary">
        浏览科研学会举办的各类活动，从学术讲座到实验工作坊，应有尽有。
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container-custom">
      {activities.length > 0 ? (
        <>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 scroll-reveal-stagger">
            {activities.map((item: any) => (<ScrollReveal><ActivityCard {...item} /></ScrollReveal>))}
          </div>
          <Pagination currentPage={page} totalPages={totalPages} baseUrl="/activities" />
        </>
      ) : (
        <p class="text-center text-small py-16">暂无活动</p>
      )}
    </div>
  </section>
</BaseLayout>
