---
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroBanner from '@components/home/HeroBanner.astro';
import AboutPreview from '@components/home/AboutPreview.astro';
import AnnouncementList from '@components/home/AnnouncementList.astro';
import ActivityList from '@components/home/ActivityList.astro';
import GalleryPreview from '@components/home/GalleryPreview.astro';
import FeatureGrid from '@components/home/FeatureGrid.astro';
import CTASection from '@components/home/CTASection.astro';
import MemoryCard from '@components/memories/MemoryCard.astro';
import { sanityClient } from 'sanity:client';
import {
  HOME_PAGE_QUERY,
  LATEST_ANNOUNCEMENTS_QUERY,
  LATEST_ACTIVITIES_QUERY,
  LATEST_GALLERY_QUERY,
  LATEST_MEMORIES_QUERY,
} from '@sanity/queries';

const [homepage, announcements, activities, galleries, memories] = await Promise.all([
  sanityClient.fetch(HOME_PAGE_QUERY),
  sanityClient.fetch(LATEST_ANNOUNCEMENTS_QUERY),
  sanityClient.fetch(LATEST_ACTIVITIES_QUERY),
  sanityClient.fetch(LATEST_GALLERY_QUERY),
  sanityClient.fetch(LATEST_MEMORIES_QUERY),
]);
---

<BaseLayout
  title="首页"
  description="科研学会官方网站 — 致力于推动学术研究与科技创新"
>
  <!-- ===== Splash Entrance ===== -->
  <div id="splash-overlay">
    <div id="scene-wrapper">
      <div id="scene-container">

        <svg id="main-svg" viewBox="0 0 1000 650" xmlns="http://www.w3.org/2000/svg">

          <defs>
            <filter id="glow-blue" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="6" result="b"/>
              <feComposite in="SourceGraphic" in2="b" operator="over"/>
            </filter>
            <filter id="glow-strong" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur stdDeviation="12" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="glow-liquid" x="-50%" y="-50%" width="200%" height="200%">
              <feGaussianBlur stdDeviation="4" result="b"/>
              <feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>
            </filter>
            <filter id="soft-glow" x="-100%" y="-100%" width="300%" height="300%">
              <feGaussianBlur stdDeviation="22"/>
            </filter>

            <linearGradient id="glass-body" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%"   stop-color="rgba(255,255,255,0.16)"/>
              <stop offset="15%"  stop-color="rgba(255,255,255,0.05)"/>
              <stop offset="50%"  stop-color="rgba(255,255,255,0.01)"/>
              <stop offset="85%"  stop-color="rgba(255,255,255,0.06)"/>
              <stop offset="100%" stop-color="rgba(255,255,255,0.12)"/>
            </linearGradient>
            <linearGradient id="ambient-glow" x1="0.5" y1="0" x2="0.5" y2="1">
              <stop offset="0%"   stop-color="rgba(0,168,255,0.14)"/>
              <stop offset="50%"  stop-color="rgba(0,168,255,0.04)"/>
              <stop offset="100%" stop-color="rgba(0,168,255,0.16)"/>
            </linearGradient>
            <linearGradient id="liquid-grad" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%"   stop-color="rgba(0,210,255,0.45)"/>
              <stop offset="30%"  stop-color="rgba(0,185,255,0.68)"/>
              <stop offset="100%" stop-color="rgba(0,105,225,0.88)"/>
            </linearGradient>

            <clipPath id="flask-inner-clip">
              <path d="M474 170 L474 248 Q474 268 445 288 Q380 440 350 540 Q347 546 355 548 L645 548 Q653 546 650 540 Q620 440 555 288 Q526 268 526 248 L526 170 Z"/>
            </clipPath>
            <clipPath id="tube-inner-clip">
              <rect x="1" y="2" width="22" height="178" rx="10"/>
            </clipPath>
          </defs>

          <!-- ===== 背景 ===== -->
          <ellipse cx="500" cy="380" rx="320" ry="220" fill="url(#ambient-glow)" opacity="0.5"/>
          <ellipse cx="500" cy="555" rx="175" ry="14" fill="rgba(0,168,255,0.08)" filter="url(#glow-blue)"/>

          <g id="bg-particles" opacity="0">
            <circle cx="200" cy="150" r="1.5" fill="rgba(0,185,255,0.6)"/>
            <circle cx="820" cy="130" r="1.2" fill="rgba(0,185,255,0.5)"/>
            <circle cx="140" cy="420" r="1.0" fill="rgba(0,185,255,0.4)"/>
            <circle cx="860" cy="440" r="1.6" fill="rgba(0,185,255,0.55)"/>
            <circle cx="280" cy="80"  r="1.0" fill="rgba(0,185,255,0.45)"/>
            <circle cx="740" cy="560" r="1.3" fill="rgba(0,185,255,0.5)"/>
            <circle cx="650" cy="80"  r="0.9" fill="rgba(0,185,255,0.4)"/>
            <circle cx="350" cy="580" r="1.1" fill="rgba(0,185,255,0.45)"/>
          </g>

          <!-- ========== 锥形瓶 ========== -->
          <g id="flask-group">
            <path id="flask-back"
              d="M462 140 L462 248 Q462 268 430 290 Q355 440 340 545 Q338 552 348 554 L652 554 Q662 552 660 545 Q645 440 570 290 Q538 268 538 248 L538 140 Z"
              fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.18)" stroke-width="1.2"/>

            <g id="liquid-group" opacity="0">
              <rect id="liquid-rect" x="340" y="545" width="320" height="0" fill="url(#liquid-grad)" clip-path="url(#flask-inner-clip)"/>
              <ellipse id="liquid-surface" cx="500" cy="545" rx="155" ry="8" fill="rgba(255,255,255,0.15)"/>
            </g>

            <g id="bubbles-group" clip-path="url(#flask-inner-clip)"></g>
            <g id="inner-particles-group" clip-path="url(#flask-inner-clip)"></g>
            <g id="electric-arcs-group" clip-path="url(#flask-inner-clip)"></g>

            <path id="flask-front"
              d="M462 140 L462 248 Q462 268 430 290 Q355 440 340 545 Q338 552 348 554 L652 554 Q662 552 660 545 Q645 440 570 290 Q538 268 538 248 L538 140 Z"
              fill="url(#glass-body)" stroke="rgba(255,255,255,0.35)" stroke-width="2"/>

            <rect id="flask-rim" x="454" y="135" width="92" height="8" rx="2" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.5)" stroke-width="1.5"/>
            <rect x="456" y="143" width="88" height="3" rx="1" fill="rgba(255,255,255,0.06)"/>

            <path id="flask-hl-left"
              d="M466 148 L466 250 Q466 264 440 284 Q370 432 354 535"
              fill="none" stroke="rgba(255,255,255,0.28)" stroke-width="3"/>
            <path d="M470 148 L470 252 Q470 262 448 280 Q380 427 365 530"
              fill="none" stroke="rgba(255,255,255,0.08)" stroke-width="6"/>
            <path d="M534 148 L534 252 Q534 262 552 282 Q620 427 635 530"
              fill="none" stroke="rgba(255,255,255,0.07)" stroke-width="4"/>
            <path d="M400 400 Q450 420 500 420 Q550 420 600 400"
              fill="none" stroke="rgba(0,168,255,0.12)" stroke-width="22" filter="url(#glow-blue)"/>
          </g>

          <ellipse id="flask-glow-core" cx="500" cy="380" rx="80" ry="100" fill="rgba(0,180,255,0)" filter="url(#soft-glow)"/>

          <!-- ========== 试管 ========== -->
          <g transform="translate(575, -10)">
            <g id="tube-group" style="transform-origin: 12px 95px;">

              <rect id="tube-liquid" x="1" y="68" width="22" height="110"
                fill="rgba(0,185,255,0.75)" clip-path="url(#tube-inner-clip)" filter="url(#glow-liquid)"/>

              <rect x="0" y="0" width="24" height="190" rx="12"
                fill="rgba(255,255,255,0.03)" stroke="rgba(255,255,255,0.16)" stroke-width="1.5"/>
              <rect x="0" y="0" width="24" height="190" rx="12"
                fill="none" stroke="rgba(255,255,255,0.35)" stroke-width="2"/>
              <rect x="3" y="5" width="4" height="180" rx="2" fill="rgba(255,255,255,0.22)"/>
              <rect x="20" y="8" width="1.5" height="172" rx="1" fill="rgba(255,255,255,0.06)"/>
              <rect x="-4" y="-4" width="32" height="6" rx="1.5"
                fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.4)" stroke-width="1.5"/>
              <ellipse cx="12" cy="187" rx="10" ry="3" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            </g>
          </g>

          <!-- ========== 液流 ========== -->

          <line id="liquid-stream-glow-outer"
            x1="488" y1="85" x2="500" y2="140"
            stroke="rgba(0,210,255,0.2)" stroke-width="30" stroke-linecap="round"
            stroke-dasharray="65" stroke-dashoffset="65"
            filter="url(#soft-glow)" opacity="0"/>

          <line id="liquid-stream-glow"
            x1="488" y1="85" x2="500" y2="140"
            stroke="rgba(80,210,255,0.38)" stroke-width="16" stroke-linecap="round"
            stroke-dasharray="65" stroke-dashoffset="65"
            filter="url(#glow-blue)" opacity="0"/>

          <line id="liquid-stream-core"
            x1="488" y1="85" x2="500" y2="140"
            stroke="rgba(180,235,255,0.9)" stroke-width="2.5" stroke-linecap="round"
            stroke-dasharray="65" stroke-dashoffset="65"
            filter="url(#glow-liquid)" opacity="0"/>

          <line id="liquid-stream"
            x1="488" y1="85" x2="500" y2="140"
            stroke="rgba(0,195,255,0.9)" stroke-width="5" stroke-linecap="round"
            stroke-dasharray="65" stroke-dashoffset="65"
            filter="url(#glow-liquid)" opacity="0"/>

          <g id="stream-droplets"></g>

          <ellipse id="smoke-hint" cx="500" cy="145" rx="18" ry="7" fill="rgba(255,255,255,0)" filter="url(#soft-glow)"/>

        </svg>

        <canvas id="smoke-canvas"></canvas>

      </div>
    </div>

    <!-- Logo -->
    <div id="logo-container">
      <img id="logo-img" src="/logo.png" alt="科研学会">
      <div id="logo-glow"></div>
    </div>
  </div>

  <!-- ===== Main Content ===== -->
  <div id="main-content" style="display:none;">
    {
      !homepage ? (
        <section class="py-20 lg:py-32 text-center hero-gradient">
          <div class="container-custom">
            <h1 class="text-3xl sm:text-4xl font-bold mb-4 text-text">科研学会</h1>
            <p class="text-base lg:text-lg mb-8 text-text-muted">欢迎来到科研学会官方网站。请先登录 Sanity Studio 设置首页内容。</p>
            <a href="/admin" class="btn-primary">前往后台管理</a>
          </div>
        </section>
      ) : (
        <>
          <HeroBanner
            title={homepage.heroTitle}
            subtitle={homepage.heroSubtitle}
            image={homepage.heroImage}
            buttonText={homepage.heroButtonText}
            buttonLink={homepage.heroButtonLink}
          />
          <AboutPreview title={homepage.aboutTitle} content={homepage.aboutText} image={homepage.aboutImage} />
          {announcements.length > 0 && <AnnouncementList announcements={announcements} />}
          {activities.length > 0 && <ActivityList activities={activities} />}
          {galleries.length > 0 && <GalleryPreview galleries={galleries} />}
          {memories.length > 0 && (
            <section class="section-lg" style="background: var(--bg-alt);">
              <div class="container-custom">
                <div class="flex items-end justify-between mb-8">
                  <div>
                    <h2 class="text-2xl sm:text-3xl font-bold text-text">精彩回忆</h2>
                    <p class="mt-2 text-text-muted text-sm">回顾科研学会的美好时光</p>
                  </div>
                  <a href="/memories" class="hidden sm:inline-flex items-center text-ocean-600 font-medium text-sm hover:text-ocean-700 transition-colors">
                    查看全部
                    <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                  </a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 scroll-reveal-stagger">
                  {memories.map((item: any) => (
                    <MemoryCard title={item.title} eventDate={item.eventDate} description={item.description} coverImage={item.coverImage} />
                  ))}
                </div>
                <div class="mt-8 text-center sm:hidden">
                  <a href="/memories" class="inline-flex items-center text-ocean-600 font-medium text-sm">
                    查看全部回忆
                    <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
                  </a>
                </div>
              </div>
            </section>
          )}
          {homepage.features?.length > 0 && <FeatureGrid features={homepage.features} />}
          <CTASection
            title={homepage.ctaTitle}
            text={homepage.ctaText}
            buttonText={homepage.ctaButtonText}
            buttonLink={homepage.ctaButtonLink}
          />
        </>
      )
    }
  </div>

  <!-- Skip button -->
  <button id="skip-splash" class="skip-splash">跳过动画</button>
</BaseLayout>

<style is:global>
  /* ===== Splash Styles ===== */
  #splash-overlay {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: #081C2F;
    font-family: 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
  }

  #splash-overlay.hide {
    opacity: 0;
    pointer-events: none;
  }

  #scene-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #scene-container {
    position: relative;
    width: 100%;
    max-width: 1100px;
    aspect-ratio: 1000 / 650;
    will-change: transform;
  }

  #main-svg {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    display: block;
  }

  #smoke-canvas {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    pointer-events: none; z-index: 5;
    background: transparent;
  }

  /* ===== Logo 层 ===== */
  #logo-container {
    position: fixed; inset: 0; z-index: 100;
    opacity: 0; pointer-events: none;
    display: flex; justify-content: center; align-items: center;
  }

  #logo-img {
    display: block;
    max-width: min(540px, 85vw);
    height: auto;
    filter: blur(20px) brightness(1.3);
    transform: scale(0.8);
    will-change: filter, transform, opacity;
  }

  #logo-glow {
    position: absolute; pointer-events: none; z-index: -1;
    width: 520px; height: 260px;
    max-width: 85vw; max-height: 45vw;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(ellipse at center,
      rgba(0,168,255,0.5) 0%,
      rgba(0,140,255,0.18) 35%,
      transparent 70%
    );
    opacity: 0;
  }

  @media (max-width: 768px) {
    #logo-img  { max-width: min(280px, 70vw); }
    #logo-glow { width: 300px; height: 140px; }
  }

  /* ===== Skip Button ===== */
  .skip-splash {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 100001;
    background: rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.5);
    border: 1px solid rgba(255,255,255,0.12);
    padding: 8px 18px;
    border-radius: 20px;
    font-size: 13px;
    cursor: pointer;
    transition: all 0.3s;
  }
  .skip-splash:hover {
    background: rgba(255,255,255,0.15);
    color: rgba(255,255,255,0.85);
  }
</style>

<script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
<script is:inline>
  (function() {
    var overlay = document.getElementById('splash-overlay');
    var mainContent = document.getElementById('main-content');
    var skipBtn = document.getElementById('skip-splash');
    if (!overlay) return;

    // ===== 跳过按钮 — 零依赖，始终可用 =====
    var skipped = false;
    function doSkip() {
      if (skipped) return;
      skipped = true;
      overlay.style.opacity = '0';
      overlay.style.pointerEvents = 'none';
      mainContent.style.display = '';
      skipBtn.style.display = 'none';
      setTimeout(function() { if (overlay && overlay.parentNode) overlay.remove(); }, 800);
    }
    if (skipBtn) skipBtn.addEventListener('click', doSkip);

    // ===== 等 GSAP CDN 就绪，超时 5s 则跳过 =====
    var retries = 0;
    function waitForGSAP() {
      retries++;
      if (typeof gsap !== 'undefined') { startAnimation(); return; }
      if (retries > 25) { doSkip(); return; } // 5s 超时
      setTimeout(waitForGSAP, 200);
    }
    waitForGSAP();

    function startAnimation() {
      if (skipped) return;

      var SC = document.getElementById('scene-container');
      var SVG = document.getElementById('main-svg');
      var CV = document.getElementById('smoke-canvas');
      var CTX = CV.getContext('2d');
      var LG = document.getElementById('logo-container');
      var LI = document.getElementById('logo-img');
      var LGL = document.getElementById('logo-glow');

      var bgP = document.querySelector('#bg-particles');
      var tubeG = document.querySelector('#tube-group');
      var tubeLiq = document.querySelector('#tube-liquid');
      var liqStream = document.querySelector('#liquid-stream');
      var liqStreamCore = document.querySelector('#liquid-stream-core');
      var liqStreamG = document.querySelector('#liquid-stream-glow');
      var liqStreamGO = document.querySelector('#liquid-stream-glow-outer');
      var dropletsG = document.querySelector('#stream-droplets');
      var liqGroup = document.querySelector('#liquid-group');
      var liqRect = document.querySelector('#liquid-rect');
      var liqSurface = document.querySelector('#liquid-surface');
      var bubblesG = document.querySelector('#bubbles-group');
      var innerParts = document.querySelector('#inner-particles-group');
      var arcGroup = document.querySelector('#electric-arcs-group');
      var flaskGlow = document.querySelector('#flask-glow-core');
      var smokeHintEl = document.querySelector('#smoke-hint');
      var flaskFrontEl = document.querySelector('#flask-front');
      var flaskHL = document.querySelector('#flask-hl-left');

      var STREAM_LEN = 65;
      var PH = {OFF:-1, LIGHT:0, NORMAL:1, DENSE:2};

      function updateCanvasSize() {
        var r = SC.getBoundingClientRect();
        var dpr = Math.min(window.devicePixelRatio || 1, 2);
        var w = Math.round(r.width * dpr), h = Math.round(r.height * dpr);
        if (CV.width !== w || CV.height !== h) { CV.width = w; CV.height = h; }
        CV.style.width = r.width + 'px'; CV.style.height = r.height + 'px';
      }
      updateCanvasSize();

      function toCanvas(svgX, svgY) {
        var sr = SVG.getBoundingClientRect();
        var cr = SC.getBoundingClientRect();
        return {x:(svgX/1000)*sr.width+(sr.left-cr.left), y:(svgY/650)*sr.height+(sr.top-cr.top)};
      }

      var dropletTimer = null;
      function startDroplets() {
        var NS = 'http://www.w3.org/2000/svg';
        function tick() {
          if (!dropletTimer) return;
          for (var i = 0; i < 4; i++) {
            var t = 0.05 + Math.random() * 0.9;
            var px = 488 + t * 12 + (Math.random() - 0.5) * 6;
            var py = 85 + t * (140 - 85);
            var r = 0.6 + Math.random() * 2.0;
            var el = document.createElementNS(NS, 'circle');
            el.setAttribute('cx', px); el.setAttribute('cy', py); el.setAttribute('r', r);
            el.setAttribute('fill', 'rgba(170,235,255,0.9)');
            el.setAttribute('filter', 'url(#glow-liquid)');
            dropletsG.appendChild(el);
            var angle = Math.random() * Math.PI * 2, dist = 2 + Math.random() * 12;
            gsap.to(el, {attr:{cx:px+Math.cos(angle)*dist, cy:py+Math.sin(angle)*dist-4, r:0}, opacity:0, duration:0.2+Math.random()*0.35, ease:'power2.out', onComplete:function(){el.remove();}});
          }
          dropletTimer = setTimeout(tick, 25 + Math.random() * 45);
        }
        tick();
      }
      function stopDroplets() { clearTimeout(dropletTimer); dropletTimer = null; }

      function mkBubble(x, y, r) {
        var el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        el.setAttribute('cx', x); el.setAttribute('cy', y); el.setAttribute('r', r);
        el.setAttribute('fill', 'rgba(255,255,255,0.2)'); el.setAttribute('stroke', 'rgba(255,255,255,0.35)'); el.setAttribute('stroke-width', '0.4');
        bubblesG.appendChild(el);
        gsap.to(el, {attr:{cy:y-18-Math.random()*90, r:r*0.18}, opacity:0, duration:1+Math.random()*2.2, delay:Math.random()*0.08, ease:'power1.out', onComplete:function(){el.remove();}});
      }
      function spawnBubbles(n, dur) { for (var i = 0; i < n; i++) gsap.delayedCall(i*(dur/n), function() { mkBubble(365+Math.random()*270, 312+Math.random()*210, 1.2+Math.random()*6); }); }

      var PCL = ['rgba(0,200,255,0.85)', 'rgba(0,242,212,0.78)', 'rgba(145,85,252,0.78)', 'rgba(180,218,255,0.82)'];
      function mkParticle(x, y) {
        var el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        el.setAttribute('cx', x); el.setAttribute('cy', y); el.setAttribute('r', 1+Math.random()*3.5);
        el.setAttribute('fill', PCL[Math.floor(Math.random()*4)]); el.setAttribute('filter', 'url(#glow-blue)');
        innerParts.appendChild(el);
        var ang = Math.random()*Math.PI*2, dist = 16+Math.random()*65;
        gsap.to(el, {attr:{cx:x+Math.cos(ang)*dist, cy:y+Math.sin(ang)*dist-16}, opacity:0, duration:0.6+Math.random()*1.6, delay:Math.random()*0.05, ease:'power2.out', onComplete:function(){el.remove();}});
      }
      function spawnParticles(n, dur) { for (var i = 0; i < n; i++) gsap.delayedCall(i*(dur/n), function() { mkParticle(365+Math.random()*270, 302+Math.random()*225); }); }

      function mkArc(x1, y1, x2, y2) {
        var mx = (x1+x2)/2+(Math.random()-0.5)*42, my = (y1+y2)/2+(Math.random()-0.5)*42;
        var el = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        el.setAttribute('d', 'M'+x1+' '+y1+' Q'+mx+' '+my+' '+x2+' '+y2);
        el.setAttribute('fill', 'none'); el.setAttribute('stroke', 'rgba(120,215,255,0.78)');
        el.setAttribute('stroke-width', '1.1'); el.setAttribute('stroke-linecap', 'round');
        el.setAttribute('filter', 'url(#glow-strong)'); el.setAttribute('opacity', '0');
        arcGroup.appendChild(el);
        var dur = 0.28+Math.random()*0.6;
        var tl = gsap.timeline({onComplete:function(){el.remove();}});
        tl.to(el, {opacity:0.82, duration:dur*0.2, ease:'power2.in'});
        tl.to(el, {opacity:0, duration:dur*0.6, ease:'power3.out'}, '+='+(dur*0.1));
      }
      function spawnArcs(n, dur) { for (var i = 0; i < n; i++) gsap.delayedCall(i*(dur/n), function() { var x1 = 370+Math.random()*260, y1 = 318+Math.random()*195; mkArc(x1, y1, x1+(Math.random()-0.5)*85, y1+(Math.random()-0.5)*65); }); }

      // ===== 烟雾系统 =====
      function SmokePt(phase) {
        var p = toCanvas(500, 140);
        var a = (Math.random()-0.5)*Math.PI*0.55, s = 0.4+Math.random()*1.0;
        this.x = p.x+(Math.random()-0.5)*40; this.y = p.y; this.life = 1;
        this.vx = Math.cos(a-Math.PI/2)*s; this.vy = Math.sin(a-Math.PI/2)*s-Math.random()*0.9;
        if (phase === PH.DENSE) { this.r = 24+Math.random()*80; this.op = 0.18+Math.random()*0.30; this.decay = 0.0004+Math.random()*0.0015; this.gr = 0.10+Math.random()*0.22; }
        else if (phase === PH.NORMAL) { this.r = 10+Math.random()*36; this.op = 0.11+Math.random()*0.22; this.decay = 0.0014+Math.random()*0.0035; this.gr = 0.06+Math.random()*0.12; }
        else { this.r = 5+Math.random()*20; this.op = 0.06+Math.random()*0.15; this.decay = 0.0022+Math.random()*0.0045; this.gr = 0.025+Math.random()*0.06; }
      }
      SmokePt.prototype.update = function() { this.x += this.vx; this.y += this.vy; this.r += this.gr; this.life -= this.decay; this.vy += -0.0004; };
      SmokePt.prototype.draw = function(ctx) {
        if (this.life <= 0 || this.op <= 0) return;
        var a = this.op * Math.min(this.life, 1);
        var g = ctx.createRadialGradient(this.x, this.y, 0, this.x, this.y, this.r);
        g.addColorStop(0, 'rgba(255,255,255,'+a.toFixed(3)+')');
        g.addColorStop(0.15, 'rgba(255,255,255,'+(a*0.68).toFixed(3)+')');
        g.addColorStop(0.42, 'rgba(228,238,252,'+(a*0.28).toFixed(3)+')');
        g.addColorStop(1, 'rgba(195,215,240,0)'); ctx.fillStyle = g;
        ctx.beginPath(); ctx.arc(this.x, this.y, this.r, 0, Math.PI*2); ctx.fill();
      };

      function SmokeSys() { this.particles = []; this.phase = PH.OFF; }
      SmokeSys.prototype.emit = function(n) { var max = 20; if (this.phase === PH.DENSE) max = 400; else if (this.phase === PH.NORMAL) max = 150; for (var i = 0; i < n; i++) { if (this.particles.length >= max) this.particles.shift(); this.particles.push(new SmokePt(this.phase)); } };
      SmokeSys.prototype.setPhase = function(p) { this.phase = p; };
      SmokeSys.prototype.update = function() { this.particles = this.particles.filter(function(p) { p.update(); return p.life > 0 && p.op > 0; }); };
      SmokeSys.prototype.draw = function(ctx) { this.particles.forEach(function(p) { p.draw(ctx); }); };
      SmokeSys.prototype.clear = function() { this.particles = []; };

      var smokeSys = new SmokeSys();
      function smokeLoop() {
        updateCanvasSize(); var dpr = Math.min(window.devicePixelRatio || 1, 2);
        CTX.save(); CTX.setTransform(dpr, 0, 0, dpr, 0, 0);
        CTX.clearRect(0, 0, CV.width/dpr, CV.height/dpr);
        smokeSys.update(); smokeSys.draw(CTX); CTX.restore();
        requestAnimationFrame(smokeLoop);
      }
      smokeLoop();

      // ===== GSAP 初始 =====
      gsap.set(tubeG, {transformOrigin:'12px 95px'});
      gsap.set(liqGroup, {opacity:0});

      var streamEls = [liqStreamGO, liqStreamG, liqStream, liqStreamCore];
      streamEls.forEach(function(el) {
        gsap.set(el, {opacity:0, attr:{'stroke-dashoffset':STREAM_LEN, 'stroke-dasharray':STREAM_LEN}});
      });

      gsap.set(LI, {opacity:0, scale:0.8, filter:'blur(20px) brightness(1.3)'});
      gsap.set(LG, {opacity:0});
      gsap.set(LGL, {opacity:0});
      gsap.set(flaskGlow, {opacity:0.04});
      gsap.set(flaskHL, {opacity:0.25});
      gsap.set(bgP, {opacity:0});
      gsap.set(smokeHintEl, {opacity:0});

      // ===== Timeline =====
      var a1 = gsap.timeline();
      a1.to(bgP, {opacity:0.5, duration:1.2, ease:'power2.out'}, 0);
      a1.to(flaskGlow, {opacity:0.18, duration:1.6, ease:'power2.out'}, 0.3);
      a1.to(flaskHL, {opacity:1, duration:1.4, ease:'power2.out'}, 0.4);
      a1.to(SC, {y:-4, duration:2, ease:'sine.inOut', yoyo:true, repeat:1}, 0);

      var a2 = gsap.timeline();
      a2.to(tubeG, {rotation:-90, duration:1.3, ease:'power3.inOut'}, 's');
      a2.to(tubeLiq, {attr:{y:165, height:8}, duration:2.3, ease:'power2.in'}, 's+=0.25');

      var dashTween = {duration:1.2, ease:'power2.inOut'};
      a2.to(liqStreamGO, {opacity:1, attr:{'stroke-dashoffset':0}, duration:1.2, ease:'power2.inOut'}, 's+=1.1');
      a2.to(liqStreamG,  {opacity:1, attr:{'stroke-dashoffset':0}, duration:1.2, ease:'power2.inOut'}, 's+=1.13');
      a2.to(liqStream,   {opacity:1, attr:{'stroke-dashoffset':0}, duration:1.2, ease:'power2.inOut'}, 's+=1.16');
      a2.to(liqStreamCore,{opacity:1, attr:{'stroke-dashoffset':0}, duration:1.1, ease:'power2.inOut'}, 's+=1.19');
      a2.to([liqStreamG, liqStreamGO], {opacity:0.55, duration:0.4, repeat:4, yoyo:true, ease:'sine.inOut', stagger:0.06}, 's+=1.25');
      a2.call(startDroplets, null, 's+=1.2');
      a2.call(stopDroplets, null, 's+=2.3');

      var a3 = gsap.timeline();
      a3.set(liqGroup, {opacity:1}, 's');
      a3.to(liqRect, {attr:{height:210, y:340}, duration:1.9, ease:'power3.in'}, 's');
      a3.to(liqSurface, {attr:{cy:340, rx:150}, duration:1.9, ease:'power3.in'}, 's');
      a3.call(function() { liqRect.setAttribute('fill', 'rgba(0,180,245,0.7)'); }, null, 's+=0.05');
      a3.call(function() { liqRect.setAttribute('fill', 'rgba(0,232,210,0.72)'); }, null, 's+=0.65');
      a3.call(function() { liqRect.setAttribute('fill', 'rgba(118,68,242,0.72)'); }, null, 's+=1.35');
      a3.call(function() { liqRect.setAttribute('fill', 'rgba(162,208,255,0.78)'); }, null, 's+=2.0');
      a3.to(flaskGlow, {opacity:0.55, duration:1.8, ease:'power3.in'}, 's+=0.35');
      a3.to(flaskHL, {opacity:1.7, duration:1.2, ease:'power2.out'}, 's+=0.65');
      a3.to(flaskFrontEl, {opacity:0.8, duration:1.0, ease:'power2.out'}, 's+=0.65');
      a3.call(function() { spawnBubbles(24, 1.4); }, null, 's+=0.4');
      a3.call(function() { spawnBubbles(34, 1.2); }, null, 's+=1.0');
      a3.call(function() { spawnBubbles(28, 1.0); }, null, 's+=1.6');
      a3.call(function() { spawnParticles(36, 1.5); }, null, 's+=0.6');
      a3.call(function() { spawnParticles(46, 1.2); }, null, 's+=1.2');
      a3.call(function() { spawnParticles(34, 1.0); }, null, 's+=1.8');
      a3.call(function() { spawnArcs(18, 1.2); }, null, 's+=0.8');
      a3.call(function() { spawnArcs(24, 1.0); }, null, 's+=1.3');
      a3.call(function() { spawnArcs(18, 0.8); }, null, 's+=1.8');

      var a4 = gsap.timeline();
      a4.call(function() { smokeSys.setPhase(PH.NORMAL); }, null, 's');
      var e4 = {v:0, p:0};
      a4.to(e4, {v:220, duration:1.5, ease:'none', onUpdate:function(){var d=e4.v-e4.p; if(d>0.7){smokeSys.emit(Math.floor(d*2.2)); e4.p=e4.v;}}}, 's');
      a4.to(smokeHintEl, {opacity:0.3, duration:0.6}, 's+=0.05');

      var a5 = gsap.timeline();
      a5.call(function() { smokeSys.setPhase(PH.DENSE); }, null, 's');
      var e5 = {v:0, p:0};
      a5.to(e5, {v:850, duration:1.5, ease:'power2.in', onUpdate:function(){var d=e5.v-e5.p; if(d>1.0){smokeSys.emit(Math.floor(d*3.5)); e5.p=e5.v;}}}, 's');
      a5.to(SC, {scale:5, duration:1.5, ease:'power3.in'}, 's+=0.05');
      a5.to(SVG, {opacity:0, duration:0.8}, 's+=0.1');

      var a6 = gsap.timeline({defaults:{ease:'power3.out'}});
      a6.set(LG, {opacity:1}, 's');
      a6.to(LI, {opacity:1, scale:1, filter:'blur(0px) brightness(1.3)', duration:1.2, ease:'power3.out'}, 's+=0.2');
      a6.to(LGL, {opacity:0.65, duration:1.0, ease:'power2.out'}, 's+=0.45');
      a6.call(function() { smokeSys.setPhase(PH.LIGHT); }, null, 's+=1.5');
      a6.to(CV, {opacity:0, duration:1.8}, 's+=1.5');
      a6.to(SC, {scale:1, duration:2.0, ease:'power3.out'}, 's+=1.5');
      a6.to(LGL, {opacity:0.45, duration:3.2, repeat:-1, yoyo:true, ease:'sine.inOut'}, 's+=2.0');

      // 动画完成后显示主内容
      a6.call(function() {
        if (skipped) return;
        overlay.classList.add('hide');
        mainContent.style.display = '';
        skipBtn.style.display = 'none';
        setTimeout(function() { if (overlay && overlay.parentNode) overlay.remove(); }, 800);
      }, null, 's+=4.5');

      var master = gsap.timeline({paused:true});
      master.add(a1, 0).add(a2, 2).add(a3, 3.5).add(a4, 6.5).add(a5, 8).add(a6, 9.5);

      // 升级跳过按钮：动画开始后也能跳过（GSAP 可用时）
      if (skipBtn) {
        skipBtn.removeEventListener('click', doSkip);
        skipBtn.addEventListener('click', function() {
          if (skipped) return;
          skipped = true;
          master.seek(14); master.pause();
          smokeSys.clear();
          stopDroplets();
          [bubblesG, innerParts, arcGroup, dropletsG].forEach(function(g) { while(g.firstChild) g.removeChild(g.firstChild); });
          overlay.style.opacity = '0';
          overlay.style.pointerEvents = 'none';
          mainContent.style.display = '';
          skipBtn.style.display = 'none';
          setTimeout(function() { if (overlay && overlay.parentNode) overlay.remove(); }, 800);
        });
      }

      window.addEventListener('load', function() {
        updateCanvasSize();
        gsap.delayedCall(0.2, function() { if (!skipped) master.play(); });
      });

      // 键盘控制
      document.addEventListener('keydown', function(e) {
        var k = e.key.toLowerCase();
        if (k === ' ') { e.preventDefault(); master.paused() ? master.play() : master.pause(); }
        else if (k === 'r') {
          master.restart(); smokeSys.clear(); stopDroplets();
          [bubblesG, innerParts, arcGroup, dropletsG].forEach(function(g) { while(g.firstChild) g.removeChild(g.firstChild); });
          liqRect.removeAttribute('fill'); liqRect.setAttribute('fill', 'url(#liquid-grad)');
          streamEls.forEach(function(el) { gsap.set(el, {opacity:0, attr:{'stroke-dashoffset':STREAM_LEN}}); });
          gsap.set(SC, {scale:1, y:0}); gsap.set(SVG, {opacity:1}); gsap.set(CV, {opacity:1});
          gsap.set(LG, {opacity:0}); gsap.set(LI, {opacity:0, scale:0.8, filter:'blur(20px) brightness(1.3)'});
          gsap.set(LGL, {opacity:0});
        }
        else if ('123456'.includes(k)) master.seek([0, 2, 3.5, 6.5, 8, 9.5][+k - 1] + 0.1);
      });
    }
  })();
</script>
