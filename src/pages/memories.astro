---
import BaseLayout from '@layouts/BaseLayout.astro';
import Lightbox from '@components/memories/Lightbox.astro';
import HomeIntro from '@components/home/HomeIntro.astro';
import { sanityClient } from 'sanity:client';
import { MEMORIES_QUERY, HOMEPAGE_PURPOSE_QUERY } from '@sanity/queries';
import { SITE } from '@lib/constants';
import { urlFor } from '../sanity/client';

const [albums, purposeDoc] = await Promise.all([
  sanityClient.fetch(MEMORIES_QUERY) as Promise<any[]>,
  sanityClient.fetch(HOMEPAGE_PURPOSE_QUERY) as Promise<{ purposes: string[] } | null>,
]);

const purposes: string[] = purposeDoc?.purposes || [];

interface Polaroid {
  src: string;
  fullSrc: string;
  alt: string;
  raw: any;
  albumTitle: string;
  eventDate: string;
}

const photos: Polaroid[] = [];
for (const album of albums) {
  const images = album.images;
  if (images && images.length > 0) {
    for (const img of images) {
      photos.push({
        src: urlFor(img).width(440).auto('format').url(),
        fullSrc: urlFor(img).width(1600).auto('format').url(),
        alt: img.alt || img.caption || album.title,
        raw: img,
        albumTitle: album.title,
        eventDate: album.eventDate,
      });
    }
  } else if (album.coverImage) {
    photos.push({
      src: urlFor(album.coverImage).width(440).auto('format').url(),
      fullSrc: urlFor(album.coverImage).width(1600).auto('format').url(),
      alt: album.title,
      raw: album.coverImage,
      albumTitle: album.title,
      eventDate: album.eventDate,
    });
  }
}

// Layout constants
const CARD_W = 200;       // polaroid card width
const CARD_BORDER = 8;    // white border padding on each side
const PHOTO_W = CARD_W - CARD_BORDER * 2; // photo area width

const NAIL_SPACING = CARD_W + 56; // horizontal spacing between nails
const PAD_X = 80;          // horizontal padding before first / after last nail
const ROPE_Y = 30;         // rope Y position in SVG (room for sag)
const NAIL_R = 5;          // nail circle radius
const PIN_H = 16;          // clothespin visible height
const PIN_W = 10;          // clothespin width
const ROPE_SAG = 36;       // rope sag depth

const SVG_H = ROPE_Y + ROPE_SAG + 40;

const totalCards = photos.length;
const totalWidth = totalCards > 0
  ? PAD_X * 2 + (totalCards - 1) * NAIL_SPACING
  : 0;

const svgViewW = totalWidth + PAD_X * 2 + 100;
const svgViewH = SVG_H;

function nailX(i: number) { return PAD_X + i * NAIL_SPACING; }
function rotation(i: number) { return (((i % 5) - 2) * 2.4).toFixed(1); }
function formatDate(d: string) { return d || ''; }
---

<BaseLayout
  title="回忆簿"
  description="科研学会的美好回忆 — 回顾历年精彩活动与珍贵时刻"
  canonical={`${SITE.url}/memories`}
>
  <Lightbox />

  <!-- Hero -->
  <section class="pt-24 sm:pt-28 pb-10 sm:pb-14 hero-gradient">
    <div class="container-custom text-center">
      <h1 class="text-3xl sm:text-5xl font-bold text-text mb-3 tracking-tight">回忆簿</h1>
      <p class="text-text-muted text-sm sm:text-base max-w-xl mx-auto leading-relaxed">
        珍贵的回忆，记录著科研学会的精彩时刻。
      </p>
    </div>
  </section>

  <!-- Intro: 项目 + 目的 -->
  <HomeIntro purposes={purposes} />

  <!-- Memory Wall -->
  <section class="pb-20 sm:pb-32" style="background: var(--bg);">
    {!albums || albums.length === 0 ? (
      <div class="container-custom text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-[#ede4d3] mb-5">
          <svg class="h-7 w-7 text-[#b8a080]" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
        </div>
        <p class="text-text-muted text-base">暂无回忆内容，请前往 Sanity 后台添加。</p>
      </div>
    ) : (
      <div class="relative group/wall" id="memory-wall">
        <!-- Scroll arrows -->
        <button
          class="absolute left-4 top-[calc(50%-30px)] -translate-y-1/2 z-30 w-11 h-11 rounded-full bg-white/90 shadow-lg flex items-center justify-center opacity-0 group-hover/wall:opacity-100 transition-opacity duration-300 border border-[#e8dfd0] hover:bg-white"
          type="button" aria-label="向左滑动" data-wall-dir="left"
        >
          <svg class="h-5 w-5 text-[#8b7355]" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg>
        </button>
        <button
          class="absolute right-4 top-[calc(50%-30px)] -translate-y-1/2 z-30 w-11 h-11 rounded-full bg-white/90 shadow-lg flex items-center justify-center opacity-0 group-hover/wall:opacity-100 transition-opacity duration-300 border border-[#e8dfd0] hover:bg-white"
          type="button" aria-label="向右滑动" data-wall-dir="right"
        >
          <svg class="h-5 w-5 text-[#8b7355]" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg>
        </button>

        <!-- Scrollable track -->
        <div
          class="overflow-x-auto scroll-smooth scrollbar-hide"
          style="scrollbar-width:none; -ms-overflow-style:none;"
          data-wall-track
        >
          <div
            class="relative inline-flex min-w-max"
            style={`height:520px; padding-left:${PAD_X}px; padding-right:${PAD_X}px; padding-top:0px; min-width:${svgViewW}px;`}
          >
            {/*
              Each "hanging unit" is a vertical block from nail → clothespin → polaroid.
              The nail and rope live in the SVG, the clothespin+polaroid are HTML positioned
              so the clothespin overlaps the SVG nail point.
            */}

            {/* SVG rope layer */}
            <svg
              class="absolute left-0 top-0 pointer-events-none z-10 overflow-visible"
              style={`width:${svgViewW}px; height:${SVG_H}px;`}
              viewBox={`0 0 ${svgViewW} ${svgViewH}`}
              aria-hidden="true"
            >
              <defs>
                <linearGradient id="rope-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%" stop-color="#c4a46c"/>
                  <stop offset="50%" stop-color="#d4b87a"/>
                  <stop offset="100%" stop-color="#b89550"/>
                </linearGradient>
              </defs>

              {/* Rope curve — one continuous path through all nail points */}
              {photos.length > 0 && (
                <path
                  d={`M ${nailX(0)} ${ROPE_Y} ${
                    photos.map((_, i) => {
                      if (i === 0) return '';
                      const px = nailX(i - 1);
                      const cx = nailX(i);
                      const mx = (px + cx) / 2;
                      return `Q ${mx} ${ROPE_Y + ROPE_SAG} ${cx} ${ROPE_Y}`;
                    }).join(' ')
                  }`}
                  fill="none"
                  stroke="url(#rope-grad)"
                  stroke-width="3.5"
                  stroke-linecap="round"
                />
              )}

              {/* Nails — one at each photo position */}
              {photos.map((_, i) => {
                const cx = nailX(i);
                const cy = ROPE_Y;
                return (
                  <g>
                    {/* Nail head */}
                    <circle cx={cx} cy={cy} r={NAIL_R} fill="#c8c4c0" stroke="#a8a098" stroke-width="1"/>
                    {/* Nail highlight */}
                    <circle cx={cx - 1.5} cy={cy - 1.5} r="1.8" fill="#ece8e4"/>
                  </g>
                );
              })}

              {/* Rope end knots */}
              {photos.length > 0 && (
                <>
                  <circle cx={nailX(0) - 12} cy={ROPE_Y} r="4" fill="none" stroke="url(#rope-grad)" stroke-width="3" opacity="0.7"/>
                  <circle cx={nailX(totalCards - 1) + 12} cy={ROPE_Y} r="4" fill="none" stroke="url(#rope-grad)" stroke-width="3" opacity="0.7"/>
                  {/* Rope tails */}
                  <path d={`M ${nailX(0) - 16} ${ROPE_Y} Q ${nailX(0) - 40} ${ROPE_Y + 28} ${nailX(0) - 50} ${ROPE_Y + 60}`} fill="none" stroke="url(#rope-grad)" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
                  <path d={`M ${nailX(totalCards - 1) + 16} ${ROPE_Y} Q ${nailX(totalCards - 1) + 40} ${ROPE_Y + 28} ${nailX(totalCards - 1) + 50} ${ROPE_Y + 60}`} fill="none" stroke="url(#rope-grad)" stroke-width="3" stroke-linecap="round" opacity="0.5"/>
                </>
              )}
            </svg>

            {/* Polaroid cards — each positioned under its nail */}
            {photos.map(function(photo, i) {
              const cx = nailX(i);
              const cardLeft = cx - CARD_W / 2;
              const pinTop = ROPE_Y + NAIL_R;
              const cardTop = pinTop + PIN_H;

              return (
                <div
                  class="absolute shrink-0"
                  style={`left:${cardLeft}px; top:${cardTop}px; width:${CARD_W}px;`}
                >
                  {/* Clothespin — positioned to overlap the nail/rope point */}
                  <div class="absolute left-1/2 -translate-x-1/2 z-20 flex flex-col items-center" style={`top:${-(PIN_H + 2)}px;`}>
                    {/* Pin body */}
                    <div
                      class="relative"
                      style={`width:${PIN_W + 4}px; height:${PIN_H + 12}px;`}
                    >
                      {/* Back jaw (behind rope) */}
                      <div class="absolute left-0 right-0 top-0 h-full rounded-b-[3px]" style="background: linear-gradient(180deg, #c8a070 0%, #b08050 100%);"></div>
                      {/* Front jaw (in front of rope, over card) */}
                      <div class="absolute left-0.5 right-0.5 top-0 h-full rounded-b-[3px]" style="background: linear-gradient(180deg, #dbb888 0%, #c4956a 80%); box-shadow: 0 1px 2px rgba(0,0,0,0.15);"></div>
                      {/* Metal spring */}
                      <div class="absolute left-0 right-0" style="top:5px; height:3px; background: linear-gradient(180deg, #999 0%, #ccc 50%, #999 100%); border-radius:1px;"></div>
                      {/* Top notch */}
                      <div class="absolute left-1/2 -translate-x-1/2 top-0" style={`width:${PIN_W - 2}px; height:3px; background:#8b6a4a; border-radius:0 0 2px 2px;`}></div>
                    </div>
                  </div>

                  {/* Polaroid card */}
                  <div
                    class="bg-white rounded-sm cursor-pointer transition-all duration-300 ease-out hover:scale-[1.04]"
                    style={`transform: rotate(${rotation(i)}deg); transform-origin: top center; box-shadow: 0 3px 8px rgba(0,0,0,0.06), 0 6px 20px rgba(0,0,0,0.04);`}
                    data-lightbox-src={photo.fullSrc}
                    data-lightbox-alt={photo.alt}
                  >
                    {/* Photo area with white border */}
                    <div class="p-2 pb-0">
                      <div class="aspect-[3/4] overflow-hidden bg-gray-100 rounded-[1px]">
                        <img
                          src={photo.src}
                          alt={photo.alt}
                          class="w-full h-full object-cover"
                          loading="lazy"
                          decoding="async"
                        />
                      </div>
                    </div>
                    {/* Date caption — centered in white area */}
                    <div class="px-3 pt-2.5 pb-3">
                      <p class="text-[11px] font-medium text-[#8b7355] tracking-wider text-center">
                        {formatDate(photo.eventDate)}
                      </p>
                      <p class="text-[9px] text-[#b8a080] tracking-wide text-center mt-0.5 leading-tight truncate">
                        {photo.albumTitle}
                      </p>
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* Fade edges */}
        <div class="pointer-events-none absolute inset-y-0 left-0 w-16 z-20" style="background: linear-gradient(90deg, var(--bg) 0%, transparent 100%);"></div>
        <div class="pointer-events-none absolute inset-y-0 right-0 w-16 z-20" style="background: linear-gradient(270deg, var(--bg) 0%, transparent 100%);"></div>
      </div>
    )}
  </section>
</BaseLayout>

<style is:global>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  function initWall() {
    // Lightbox click
    document.addEventListener('click', function(e) {
      var el = (e.target as HTMLElement).closest('[data-lightbox-src]') as HTMLElement;
      if (!el) return;
      var src = el.dataset.lightboxSrc;
      var alt = el.dataset.lightboxAlt;
      if (window.__openLightbox) window.__openLightbox(src, alt);
    });

    var track = document.querySelector('[data-wall-track]') as HTMLElement;
    if (!track) return;

    var leftBtn = document.querySelector('[data-wall-dir="left"]') as HTMLElement;
    var rightBtn = document.querySelector('[data-wall-dir="right"]') as HTMLElement;
    var scrollAmount = 280;

    if (leftBtn) {
      leftBtn.addEventListener('click', function() {
        track.scrollBy({ left: -scrollAmount, behavior: 'smooth' });
      });
    }
    if (rightBtn) {
      rightBtn.addEventListener('click', function() {
        track.scrollBy({ left: scrollAmount, behavior: 'smooth' });
      });
    }

    // Mouse wheel → horizontal scroll
    track.addEventListener('wheel', function(e) {
      if (Math.abs(e.deltaY) > Math.abs(e.deltaX)) {
        e.preventDefault();
        track.scrollLeft += e.deltaY;
      }
    }, { passive: false });

    // Drag to scroll
    var isDown = false, startX = 0, scrollLeft = 0;
    track.addEventListener('mousedown', function(e) {
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      track.style.cursor = 'grabbing';
    });
    track.addEventListener('mouseleave', function() {
      isDown = false;
      track.style.cursor = '';
    });
    track.addEventListener('mouseup', function() {
      isDown = false;
      track.style.cursor = '';
    });
    track.addEventListener('mousemove', function(e) {
      if (!isDown) return;
      e.preventDefault();
      track.scrollLeft = scrollLeft - (e.pageX - track.offsetLeft - startX) * 1.5;
    });
  }

  initWall();
  document.addEventListener('astro:after-swap', initWall);
</script>
