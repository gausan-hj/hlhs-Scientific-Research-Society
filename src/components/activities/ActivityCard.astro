---
import SanityImage from '../common/SanityImage.astro';
import { formatDate } from '@lib/utils';

interface Props {
  slug: { current: string };
  title: string;
  date: string;
  endDate?: string;
  location: string;
  coverImage?: any;
  excerpt?: string;
}

const { slug, title, date, endDate, location, coverImage, excerpt } = Astro.props;
---

<a href={`/activities/${slug.current}`} class="card group block">
  {coverImage && (
    <div class="img-zoom-container rounded-t-xl overflow-hidden">
      <SanityImage
        image={coverImage}
        alt={title}
        class="w-full aspect-video object-cover"
        maxWidth={600}
      />
    </div>
  )}
  <div class="p-5">
    <div class="flex items-center gap-2 mb-3 text-xs text-text-muted">
      <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
      </svg>
      <span>{formatDate(date)}</span>
      {endDate && <span> — {formatDate(endDate)}</span>}
      <span aria-hidden="true">·</span>
      <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
      </svg>
      <span class="truncate">{location}</span>
    </div>
    <h3 class="text-lg font-semibold text-text group-hover:text-ocean-600 transition-colors line-clamp-2">
      {title}
    </h3>
    {excerpt && (
      <p class="mt-2 text-sm text-text-muted line-clamp-2">{excerpt}</p>
    )}
  </div>
</a>
