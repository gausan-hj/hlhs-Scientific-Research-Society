---
import SanityImage from '../common/SanityImage.astro';

interface Props {
  name: string;
  role: string;
  term: string;
  photo?: any;
  bio?: string;
}

const { name, role, term, photo, bio } = Astro.props;

const roleMap: Record<string, string> = {
  president: '主席',
  'vice-president': '副主席',
  secretary: '秘书',
  treasurer: '财政',
  academic: '学术',
  publicity: '宣传',
  'general-affairs': '总务',
  recreation: '康乐',
  it: 'IT',
};
---

<div class="card p-5">
  <div class="flex items-center gap-4">
    {photo ? (
      <div class="w-16 h-16 rounded-full overflow-hidden shrink-0">
        <SanityImage image={photo} alt={name} class="w-full h-full object-cover" maxWidth={150} />
      </div>
    ) : (
      <div class="w-16 h-16 rounded-full bg-ocean-100 dark:bg-ocean-900/30 flex items-center justify-center shrink-0">
        <span class="text-xl font-bold text-ocean-600">{name[0]}</span>
      </div>
    )}
    <div>
      <h3 class="font-semibold text-text">{name}</h3>
      <p class="text-sm text-ocean-600 font-medium">{roleMap[role] || role}</p>
      <p class="text-xs text-text-muted">{term}</p>
    </div>
  </div>
  {bio && <p class="mt-3 text-sm text-text-muted">{bio}</p>}
</div>
