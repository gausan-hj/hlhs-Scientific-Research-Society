---
import SanityImage from '../common/SanityImage.astro';

interface Props {
  title: string;
  eventDate: string;
  description?: string;
  coverImage?: any;
}

const { title, eventDate, description, coverImage } = Astro.props;
---

<a href="/memories" class="card group block">
  {coverImage ? (
    <div class="img-zoom-container rounded-t-xl overflow-hidden">
      <SanityImage
        image={coverImage}
        alt={title}
        class="w-full aspect-[4/3] object-cover"
        maxWidth={600}
      />
    </div>
  ) : (
    <div class="aspect-[4/3] bg-gradient-to-br from-ocean-100 to-wave-50 dark:from-ocean-900/30 dark:to-wave-900/20 rounded-t-xl flex items-center justify-center">
      <span class="text-4xl">📸</span>
    </div>
  )}
  <div class="p-5">
    <span class="text-xs text-text-muted">{eventDate}</span>
    <h3 class="text-lg font-semibold text-text group-hover:text-ocean-600 transition-colors line-clamp-1 mt-1">
      {title}
    </h3>
    {description && (
      <p class="mt-2 text-sm text-text-muted line-clamp-2">{description}</p>
    )}
    <div class="mt-3 flex items-center text-ocean-600 font-medium text-sm">
      查看更多回忆
      <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
      </svg>
    </div>
  </div>
</a>
