---
import SanityImage from '../common/SanityImage.astro';

export interface Props {
  image?: any;
  alt?: string;
  caption?: string;
  albumTitle?: string;
  eventDate?: string;
}

const { image, alt = '', caption, albumTitle = '', eventDate = '' } = Astro.props;
---

<div class="polaroid group">
  <div class="bg-white dark:bg-[#f5f0e8] rounded-md shadow-lg overflow-hidden transition-all duration-300 ease-out group-hover:scale-[1.02] group-hover:shadow-xl group-hover:z-10">
    <div class="p-2 pb-0">
      <div class="aspect-[3/4] overflow-hidden rounded-sm bg-gray-100 dark:bg-gray-200">
        <SanityImage
          image={image}
          alt={alt || albumTitle}
          class="w-full h-full object-cover"
          maxWidth={400}
        />
      </div>
    </div>
    <div class="px-3 pt-3 pb-4 text-center bg-white dark:bg-[#f5f0e8]">
      <p class="text-xs font-medium text-gray-700 leading-tight mb-1 truncate">{albumTitle}</p>
      <p class="text-[10px] text-gray-400 tracking-wide">{eventDate}</p>
    </div>
  </div>
</div>
