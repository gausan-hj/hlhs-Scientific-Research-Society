---
import ScrollReveal from '../common/ScrollReveal.astro';

interface Feature { icon?: string; title: string; description?: string; }
interface Props { features: Feature[]; }
const { features } = Astro.props;

const iconMap: Record<string, string> = {
  flask: '🔬', users: '👥', trophy: '🏆', book: '📖', star: '⭐',
  lightbulb: '💡', chart: '📊', globe: '🌐', rocket: '🚀', heart: '❤️',
  code: '💻', brain: '🧠',
};
---

<section class="section-lg" style="background: var(--bg-alt);">
  <div class="container-custom">
    <ScrollReveal>
      <div class="text-center mb-12">
        <div class="section-label justify-center">Why Join</div>
        <h2 class="mb-3 text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold text-text">学会特色</h2>
        <p class="text-small max-w-md mx-auto">加入科研学会，与我们一起探索未知</p>
      </div>
    </ScrollReveal>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 scroll-reveal-stagger max-w-5xl mx-auto">
      {features.map((feat) => (
        <ScrollReveal>
          <div class="card-static p-7 group text-center transition-shadow duration-300 hover:shadow-md hover:border-ocean-200">
            <div class="text-3xl mb-4 opacity-90" aria-hidden="true">{iconMap[feat.icon||''] || feat.icon || '✨'}</div>
            <h3 class="text-lg font-semibold mb-2 text-text">{feat.title}</h3>
            {feat.description && <p class="text-small leading-relaxed">{feat.description}</p>}
          </div>
        </ScrollReveal>
      ))}
    </div>
  </div>
</section>
