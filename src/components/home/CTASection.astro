---
import ScrollReveal from '../common/ScrollReveal.astro';

interface Props { title: string; text?: string; buttonText: string; buttonLink: string; }
const { title, text, buttonText, buttonLink } = Astro.props;
---

<section class="section-lg">
  <div class="container-custom">
    <ScrollReveal>
      <div class="relative rounded-2xl overflow-hidden" style="background: linear-gradient(135deg, var(--color-ocean-700), var(--color-ocean-800));">
        <div class="relative z-10 p-10 sm:p-14 lg:p-20 text-center max-w-3xl mx-auto">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">{title}</h2>
          {text && <p class="text-white/85 text-base sm:text-lg leading-relaxed mb-8">{text}</p>}
          <a href={buttonLink} class="inline-flex items-center gap-2 px-7 py-3 rounded-lg bg-white text-ocean-700 font-semibold text-sm hover:bg-ocean-50 transition-colors shadow-md">
            {buttonText}
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
