---
import ScrollReveal from '../common/ScrollReveal.astro';

interface Props {
  title: string;
  text?: string;
  buttonText: string;
  buttonLink: string;
}

const { title, text, buttonText, buttonLink } = Astro.props;
---

<section class="py-16 lg:py-24">
  <div class="container-custom">
    <ScrollReveal>
      <div class="relative overflow-hidden rounded-2xl bg-gradient-to-br from-primary-600 to-secondary-600 p-8 sm:p-12 lg:p-16 text-center">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4">{title}</h2>
        {text && (
          <p class="text-primary-100 text-lg max-w-2xl mx-auto mb-8">{text}</p>
        )}
        <a
          href={buttonLink}
          class="inline-flex items-center px-8 py-3 rounded-xl bg-white text-primary-700 font-semibold text-sm hover:bg-primary-50 transition-colors shadow-lg"
        >
          {buttonText}
          <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>

        {/* Decorative */}
        <div class="absolute top-0 right-0 -z-0 opacity-20" aria-hidden="true">
          <svg width="300" height="300" viewBox="0 0 300 300" fill="white">
            <circle cx="200" cy="50" r="100" />
            <circle cx="50" cy="200" r="80" />
          </svg>
        </div>
      </div>
    </ScrollReveal>
  </div>
</section>
