---
export interface Props {
  purposes?: string[];
}

const { purposes = [] } = Astro.props;

const defaultPurposes = [
  '让大家更加了解科研，激发学生对科学的兴趣',
  '培养学生的动手能力',
  '方便学生查看历届科研作品',
];

const displayPurposes = purposes.length > 0 ? purposes : defaultPurposes;
---

<section class="section-lg" style="background: var(--bg);">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20">

      <!-- Left: Projects -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-text mb-6 lg:mb-8">项目</h2>
        <div class="grid grid-cols-3 gap-4 sm:gap-6 max-w-md">
          <!-- Chemistry -->
          <div class="flex flex-col items-center gap-3">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-ocean-50 dark:bg-ocean-900/20 flex items-center justify-center">
              <svg class="h-8 w-8 sm:h-10 sm:w-10 text-ocean-600 dark:text-ocean-400" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 4h20M30 4v18l-14 24a4 4 0 003.2 6h25.6a4 4 0 003.2-6L34 22V4"/>
                <path d="M18 46c0 8 14 14 14 0" fill="currentColor" opacity="0.3"/>
                <circle cx="28" cy="34" r="2" opacity="0.5"/>
                <circle cx="34" cy="38" r="1.5" opacity="0.5"/>
                <circle cx="30" cy="44" r="1" opacity="0.4"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-text-muted">化学</span>
          </div>

          <!-- Physics -->
          <div class="flex flex-col items-center gap-3">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-ocean-50 dark:bg-ocean-900/20 flex items-center justify-center">
              <svg class="h-8 w-8 sm:h-10 sm:w-10 text-ocean-600 dark:text-ocean-400" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="32" cy="32" r="6"/>
                <ellipse cx="32" cy="32" rx="22" ry="10" transform="rotate(0 32 32)"/>
                <ellipse cx="32" cy="32" rx="22" ry="10" transform="rotate(60 32 32)"/>
                <ellipse cx="32" cy="32" rx="22" ry="10" transform="rotate(-60 32 32)"/>
                <circle cx="54" cy="32" r="2.5" fill="currentColor"/>
                <circle cx="17" cy="17" r="2.5" fill="currentColor"/>
                <circle cx="17" cy="47" r="2.5" fill="currentColor"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-text-muted">物理</span>
          </div>

          <!-- Biology -->
          <div class="flex flex-col items-center gap-3">
            <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-ocean-50 dark:bg-ocean-900/20 flex items-center justify-center">
              <svg class="h-8 w-8 sm:h-10 sm:w-10 text-ocean-600 dark:text-ocean-400" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M16 8C16 8 28 22 28 32S16 56 16 56"/>
                <path d="M48 8C48 8 36 22 36 32S48 56 48 56"/>
                <line x1="22" y1="16" x2="42" y2="16"/>
                <line x1="19" y1="25" x2="45" y2="25"/>
                <line x1="19" y1="32" x2="45" y2="32"/>
                <line x1="19" y1="39" x2="45" y2="39"/>
                <line x1="22" y1="48" x2="42" y2="48"/>
              </svg>
            </div>
            <span class="text-sm font-medium text-text-muted">生物</span>
          </div>
        </div>
      </div>

      <!-- Right: Purpose -->
      <div>
        <h2 class="text-2xl sm:text-3xl font-bold text-text mb-6 lg:mb-8">目的</h2>
        <ul class="space-y-4">
          {displayPurposes.map(function(purpose: string) {
            return (
              <li class="flex items-start gap-3">
                <span class="mt-2 w-2 h-2 rounded-full bg-ocean-500 shrink-0"></span>
                <span class="text-text-muted leading-relaxed">{purpose}</span>
              </li>
            );
          })}
        </ul>
      </div>

    </div>
  </div>
</section>
