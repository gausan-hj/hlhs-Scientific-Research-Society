---
import ScrollReveal from '../common/ScrollReveal.astro';
import CategoryBadge from '../common/CategoryBadge.astro';
import SanityImage from '../common/SanityImage.astro';
import { formatDate } from '@lib/utils';

interface Announcement {
  _id: string;
  title: string;
  slug: { current: string };
  publishedAt: string;
  category: string;
  coverImage?: any;
  excerpt?: string;
}

interface Props {
  announcements: Announcement[];
}

const { announcements } = Astro.props;
---

<section class="py-16 lg:py-24 bg-bg-alt">
  <div class="container-custom">
    <div class="flex items-end justify-between mb-10">
      <div>
        <h2 class="text-3xl sm:text-4xl font-bold text-text">最新公告</h2>
        <p class="mt-2 text-text-muted">了解學會最新消息與動態</p>
      </div>
      <a
        href="/announcements"
        class="hidden sm:inline-flex items-center text-primary-600 font-medium text-sm hover:text-primary-700 transition-colors"
      >
        查看全部
        <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 scroll-reveal-stagger">
      {announcements.map((item) => (
        <a href={`/announcements/${item.slug.current}`} class="card group block">
          <ScrollReveal>
            {item.coverImage && (
              <div class="img-zoom-container rounded-t-xl overflow-hidden">
                <SanityImage
                  image={item.coverImage}
                  alt={item.title}
                  class="w-full aspect-video object-cover"
                  maxWidth={600}
                />
              </div>
            )}
            <div class="p-5">
              <div class="flex items-center gap-2 mb-3">
                <CategoryBadge category={item.category} />
                <span class="text-xs text-text-muted">{formatDate(item.publishedAt)}</span>
              </div>
              <h3 class="text-lg font-semibold text-text group-hover:text-primary-600 transition-colors line-clamp-2">
                {item.title}
              </h3>
              {item.excerpt && (
                <p class="mt-2 text-sm text-text-muted line-clamp-2">{item.excerpt}</p>
              )}
            </div>
          </ScrollReveal>
        </a>
      ))}
    </div>

    {/* Mobile view all link */}
    <div class="mt-8 text-center sm:hidden">
      <a
        href="/announcements"
        class="inline-flex items-center text-primary-600 font-medium text-sm"
      >
        查看全部公告
        <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
