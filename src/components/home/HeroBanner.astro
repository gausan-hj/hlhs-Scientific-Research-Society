---
import SanityImage from '../common/SanityImage.astro';
import ScrollReveal from '../common/ScrollReveal.astro';

interface Props {
  title: string;
  subtitle?: string;
  image?: any;
  buttonText?: string;
  buttonLink?: string;
}

const { title, subtitle, image, buttonText = '了解更多', buttonLink = '/about' } = Astro.props;
---

<section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-secondary-50 dark:from-slate-900 dark:via-slate-900 dark:to-secondary-950">
  <div class="container-custom py-20 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-text leading-tight tracking-tight">
          {title}
        </h1>
        {subtitle && (
          <p class="text-lg sm:text-xl text-text-muted leading-relaxed max-w-lg">
            {subtitle}
          </p>
        )}
        <div class="flex gap-4">
          <a
            href={buttonLink}
            class="inline-flex items-center px-6 py-3 rounded-xl bg-primary-600 text-white font-medium text-sm hover:bg-primary-700 transition-colors shadow-lg shadow-primary-600/25 hover:shadow-xl hover:shadow-primary-600/30"
          >
            {buttonText}
            <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>
      </div>

      {image && (
        <div class="hidden lg:block">
          <SanityImage
            image={image}
            alt={title}
            class="rounded-2xl shadow-2xl"
            maxWidth={600}
          />
        </div>
      )}
    </div>
  </div>

  <!-- Decorative background shapes -->
  <div class="absolute top-0 right-0 -z-10 opacity-20 dark:opacity-10" aria-hidden="true">
    <svg width="600" height="600" viewBox="0 0 600 600" fill="none">
      <circle cx="500" cy="100" r="200" fill="url(#grad1)" />
      <circle cx="100" cy="400" r="150" fill="url(#grad2)" />
      <defs>
        <radialGradient id="grad1"><stop stop-color="var(--color-primary-400)" /><stop offset="1" stop-color="transparent" /></radialGradient>
        <radialGradient id="grad2"><stop stop-color="var(--color-secondary-400)" /><stop offset="1" stop-color="transparent" /></radialGradient>
      </defs>
    </svg>
  </div>
</section>
