---
import SanityImage from '../common/SanityImage.astro';
import ScrollReveal from '../common/ScrollReveal.astro';
import { truncate } from '@lib/utils';

interface Props {
  title: string;
  content?: any[];
  image?: any;
}

const { title, content, image } = Astro.props;
---

<section class="py-16 lg:py-24">
  <div class="container-custom">
    <ScrollReveal>
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <h2 class="text-3xl sm:text-4xl font-bold text-text">{title}</h2>
          {content && content.length > 0 && (
            <div class="text-text-muted leading-relaxed space-y-4">
              {content.slice(0, 2).map((block: any) => {
                if (block._type === 'block' && block.style === 'normal') {
                  const text = block.children?.map((c: any) => c.text || '').join('') || '';
                  return <p>{truncate(text, 200)}</p>;
                }
                return null;
              })}
            </div>
          )}
          <a
            href="/about"
            class="inline-flex items-center text-primary-600 font-medium text-sm hover:text-primary-700 transition-colors"
          >
            了解更多
            <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </a>
        </div>

        {image && (
          <div class="rounded-2xl overflow-hidden shadow-xl">
            <SanityImage image={image} alt={title} class="w-full" maxWidth={600} />
          </div>
        )}
      </div>
    </ScrollReveal>
  </div>
</section>
