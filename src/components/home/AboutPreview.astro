---
import SanityImage from '../common/SanityImage.astro';
import ScrollReveal from '../common/ScrollReveal.astro';

interface Props {
  title: string;
  content?: any[];
  image?: any;
}

const { title, content, image } = Astro.props;

function extractText(block: any): string {
  return block.children?.map((c: any) => c.text || '').join('') || '';
}
---

<section class="section-lg">
  <div class="container-custom">
    <ScrollReveal>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="space-y-5 text-center lg:text-left">
          <div class="section-label justify-center lg:justify-start">关于我们</div>
          <h2 class="text-[clamp(1.5rem,3.5vw,2.25rem)] font-bold leading-tight text-text">{title}</h2>
          {content && content.length > 0 && (
            <div class="space-y-3 text-text-secondary leading-relaxed">
              {content.slice(0, 2).map((block: any) => (
                block._type === 'block' && block.style === 'normal' && <p>{extractText(block)}</p>
              ))}
            </div>
          )}
          <a href="/about" class="btn-ghost mt-2">
            了解更多
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"/></svg>
          </a>
        </div>
        {image && (
          <div class="rounded-xl overflow-hidden shadow-lg border border-border-light">
            <SanityImage image={image} alt={title} class="w-full" maxWidth={600} />
          </div>
        )}
      </div>
    </ScrollReveal>
  </div>
</section>
