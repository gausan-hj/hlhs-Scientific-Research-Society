---
import { NAV_LINKS, SITE } from '@lib/constants';
import ThemeToggle from './ThemeToggle.astro';

const currentPath = Astro.url.pathname;

function getActiveIndex(path: string): number {
  if (path === '/') return 0;
  return NAV_LINKS.findIndex((link) => link.href !== '/' && path.startsWith(link.href));
}
const activeIndex = getActiveIndex(currentPath);
---

<header class="sticky top-0 z-50 border-b backdrop-blur-sm" style="background: color-mix(in srgb, var(--bg) 92%, transparent); border-color: var(--border-light);" role="banner">
  <div class="container-custom">
    <nav class="flex items-center justify-between h-14" aria-label="主导航">

      <a href="/" class="flex items-center gap-2.5 shrink-0 hover:opacity-80 transition-opacity" aria-label={`${SITE.name} — 回到首页`}>
        <img src="/logo.png" alt={SITE.name} class="h-9 w-auto" />
      </a>

      <!-- Desktop Nav -->
      <div class="hidden md:flex items-center gap-1">
        {NAV_LINKS.map((link, i) => {
          const isActive = i === activeIndex;
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-md text-[0.9rem] font-medium transition-colors duration-200 ${
                isActive
                  ? 'text-ocean-700 bg-ocean-50 dark:bg-ocean-950/30'
                  : 'text-secondary hover:text-ocean-700 hover:bg-ocean-50/50 dark:hover:bg-ocean-950/20'
              }`}
              aria-current={isActive ? 'page' : undefined}
            >
              {link.label}
            </a>
          );
        })}
      </div>

      <!-- Right side -->
      <div class="flex items-center gap-1.5">
        <ThemeToggle />
        <button
          id="mobile-menu-btn" type="button"
          class="md:hidden p-2 rounded-md text-secondary hover:text-ocean-700 hover:bg-bg-alt transition-colors"
          aria-label="打开菜单" aria-expanded="false" aria-controls="mobile-menu"
        >
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="hidden md:hidden border-t border-border py-3" role="menu">
      <ul class="flex flex-col gap-0.5">
        {NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <li role="none">
              <a href={link.href} role="menuitem"
                class={`block px-3.5 py-2.5 rounded-md text-[0.9rem] font-medium transition-colors ${
                  isActive ? 'text-ocean-700 bg-ocean-50 dark:bg-ocean-950/30' : 'text-secondary hover:text-ocean-700 hover:bg-bg-alt'
                }`}
                aria-current={isActive ? 'page' : undefined}>{link.label}</a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</header>

<script>
  function initMobileMenu(){const b=document.getElementById('mobile-menu-btn'),m=document.getElementById('mobile-menu');if(!b||!m)return;b.addEventListener('click',()=>{const o=!m.classList.contains('hidden');m.classList.toggle('hidden');b.setAttribute('aria-expanded',String(!o));b.setAttribute('aria-label',o?'打开菜单':'关闭菜单');});}
  initMobileMenu();
  document.addEventListener('astro:after-swap',initMobileMenu);
</script>
