---
import { getPaginationRange } from '@lib/utils';

interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string;
}

const { currentPage, totalPages, baseUrl } = Astro.props;
const hasPages = totalPages > 1;
if (!hasPages) return null;

const pages = getPaginationRange(currentPage, totalPages);
---

<nav class="flex items-center justify-center gap-1 py-8" aria-label="分頁導航">
  <!-- Previous -->
  {currentPage > 1 ? (
    <a
      href={`${baseUrl}?page=${currentPage - 1}`}
      class="px-3 py-2 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-bg-alt transition-colors"
      aria-label="上一頁"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </a>
  ) : (
    <span class="px-3 py-2 rounded-lg text-sm text-text-muted/40" aria-hidden="true">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" />
      </svg>
    </span>
  )}

  <!-- Page Numbers -->
  {pages.map((page) => {
    if (page === '...') {
      return <span class="px-2 text-text-muted">...</span>;
    }
    const isActive = page === currentPage;
    return (
      <a
        href={`${baseUrl}?page=${page}`}
        class={`px-3 py-2 rounded-lg text-sm font-medium transition-colors ${
          isActive
            ? 'bg-primary-600 text-white'
            : 'text-text-muted hover:text-text hover:bg-bg-alt'
        }`}
        aria-current={isActive ? 'page' : undefined}
        aria-label={`第 ${page} 頁`}
      >
        {page}
      </a>
    );
  })}

  <!-- Next -->
  {currentPage < totalPages ? (
    <a
      href={`${baseUrl}?page=${currentPage + 1}`}
      class="px-3 py-2 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-bg-alt transition-colors"
      aria-label="下一頁"
    >
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </a>
  ) : (
    <span class="px-3 py-2 rounded-lg text-sm text-text-muted/40" aria-hidden="true">
      <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
      </svg>
    </span>
  )}
</nav>
