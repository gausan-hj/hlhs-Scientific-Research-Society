---
import { SITE } from '@lib/constants';
---

<footer role="contentinfo" style="background: var(--bg-alt); border-top: 1px solid var(--border-light);">
  <div class="container-custom py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">

      <!-- Brand -->
      <div class="md:col-span-2">
        <a href="/" class="inline-flex items-center gap-2.5 mb-4">
          <img src="/logo.png" alt={SITE.name} class="h-9 w-auto" />
        </a>
        <p class="text-small max-w-xs leading-relaxed">{SITE.description}</p>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-4 text-[0.8rem] font-700 tracking-wider uppercase" style="color: var(--text)">导航</h4>
        <ul class="space-y-2.5">
          <li><a href="/about" class="text-small hover:text-ocean-700 transition-colors">关于我们</a></li>
          <li><a href="/activities" class="text-small hover:text-ocean-700 transition-colors">活动</a></li>
          <li><a href="/announcements" class="text-small hover:text-ocean-700 transition-colors">公告</a></li>
          <li><a href="/memories" class="text-small hover:text-ocean-700 transition-colors">回忆簿</a></li>
          <li><a href="/resources" class="text-small hover:text-ocean-700 transition-colors">资源</a></li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <h4 class="mb-4 text-[0.8rem] font-700 tracking-wider uppercase" style="color: var(--text)">联系</h4>
        <p class="text-small leading-relaxed">如有任何查询，欢迎联系科研学会负责老师或干事。</p>
      </div>
    </div>

    <div class="mt-10 pt-8 border-t" style="border-color: var(--border-light);">
      <p class="text-xs text-center">&copy; {new Date().getFullYear()} {SITE.name}。版权所有。</p>
    </div>
  </div>
</footer>
